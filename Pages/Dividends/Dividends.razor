@page "/dividends"
@inject DataStore Store
<h1>Dividend Tracker</h1>
<p class="subtitle">Log dividends received. Declare all dividends on your Irish Form 12 by 31 Oct each year.</p>
@* ── Summary Cards ── *@
<div style="display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:1.5rem">
    <div class="card" style="flex:1; min-width:180px">
        <div style="color:var(--muted); font-size:0.85rem">Total Received</div>
        <div style="font-size:1.4rem; font-weight:700; color:var(--good)">
            €@TotalEur().ToString("N2")
        </div>
    </div>
    <div class="card" style="flex:1; min-width:180px">
        <div style="color:var(--muted); font-size:0.85rem">Withholding Tax Paid</div>
        <div style="font-size:1.4rem; font-weight:700; color:var(--bad)">
            €@TotalWithholdingEur().ToString("N2")
        </div>
    </div>
    <div class="card" style="flex:1; min-width:180px">
        <div style="color:var(--muted); font-size:0.85rem">Net Received</div>
        <div style="font-size:1.4rem; font-weight:700">
            €@(TotalEur() - TotalWithholdingEur())
        </div>
    </div>
    <div class="card" style="flex:1; min-width:180px">
        <div style="color:var(--muted); font-size:0.85rem">@DateTime.Today.Year Dividends</div>
        <div style="font-size:1.4rem; font-weight:700">
            €@ThisYearEur().ToString("N2")
        </div>
    </div>
</div>
@* ── Per Holding Summary ── *@
<h3>By Holding</h3>
<table class="grid" style="margin-bottom:1.5rem">
    <thead>
        <tr>
            <th>Holding</th>
            <th>Payments</th>
            <th>Total Gross (€)</th>
            <th>Withholding Tax (€)</th>
            <th>Net Received (€)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Store.Data.Holdings)
        {
            var divs = Store.Data.Dividends.Where(d => d.HoldingId == h.Id).ToList();
            if (!divs.Any()) continue;
            var gross = divs.Sum(d => ToEur(d));
            var wht = divs.Sum(d => ToEurWht(d));
            <tr>
                <td><strong>@h.Name</strong></td>
                <td>@divs.Count payments</td>
                <td class="num">€@gross.ToString("N2")</td>
                <td class="num" style="color:var(--bad)">€@wht.ToString("N2")</td>
                <td class="num" style="color:var(--good)">€@((gross - wht).ToString("N2"))</td>
            </tr>
        }
    </tbody>
</table>
@* ── Annual Summary ── *@
<h3>By Year (for Irish Tax Filing)</h3>
<table class="grid" style="margin-bottom:1.5rem">
    <thead>
        <tr>
            <th>Year</th>
            <th>Payments</th>
            <th>Gross (€)</th>
            <th>Withholding Tax (€)</th>
            <th>Net (€)</th>
            <th>Tax Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var year in Store.Data.Dividends.Select(d => d.Date.Year).Distinct().OrderByDescending(y => y))
        {
            var yearDivs = Store.Data.Dividends.Where(d => d.Date.Year == year).ToList();
            var gross = yearDivs.Sum(d => ToEur(d));
            var wht = yearDivs.Sum(d => ToEurWht(d));
            <tr>
                <td><strong>@year</strong></td>
                <td>@yearDivs.Count</td>
                <td class="num">€@gross.ToString("N2")</td>
                <td class="num" style="color:var(--bad)">€@wht.ToString("N2")</td>
                <td class="num" style="color:var(--good)">€@((gross - wht).ToString("N2"))</td>
                <td>
                    @if (year < DateTime.Today.Year)
                    {
                        <span style="color:var(--bad)">⚠️ Declare on Form 12</span>
                    }
                    else
                    {
                        <span style="color:var(--muted)">Current year</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@* ── Full Transaction History ── *@
<h3>Full History</h3>
<table class="grid" style="margin-bottom:1.5rem">
    <thead>
        <tr>
            <th>Date</th>
            <th>Holding</th>
            <th>Gross Amount</th>
            <th>Currency</th>
            <th>Withholding Tax</th>
            <th>Net Received</th>
            <th>Value (€)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Store.Data.Dividends.OrderByDescending(d => d.Date))
        {
            var holding = Store.Data.Holdings.FirstOrDefault(h => h.Id == d.HoldingId);
            var eurValue = ToEur(d);
            var eurWht = ToEurWht(d);
            <tr>
                <td>@d.Date.ToString("dd MMM yyyy")</td>
                <td>@(holding?.Name ?? "—")</td>
                <td class="num">@d.Amount.ToString("N2")</td>
                <td>@d.Currency</td>
                <td class="num" style="color:var(--bad)">@d.WithholdingTax.ToString("N2")</td>
                <td class="num">@((d.Amount - d.WithholdingTax).ToString("N2"))</td>
                <td class="num" style="color:var(--good)">€@((eurValue - eurWht).ToString("N2"))</td>
                <td><button class="link-btn" @onclick="() => RemoveDividend(d)">✕</button></td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="2"><strong>Total</strong></td>
            <td class="num"><strong>€@TotalEur().ToString("N2")</strong></td>
            <td></td>
            <td class="num" style="color:var(--bad)"><strong>€@TotalWithholdingEur().ToString("N2")</strong></td>
            <td></td>
            <td class="num" style="color:var(--good)"><strong>€@(TotalEur() - TotalWithholdingEur())</strong></td>
            <td></td>
        </tr>
    </tfoot>
</table>
@* ── Log New Dividend ── *@
<div class="card">
    <h3 style="margin-top:0">Log New Dividend</h3>
    <div style="display:flex; gap:1rem; flex-wrap:wrap; align-items:flex-end">
        <label>
            Holding:
            <select @bind="_holdingId">
                @foreach (var h in Store.Data.Holdings)
                {
                    <option value="@h.Id">@h.Name</option>
                }
            </select>
        </label>
        <label>Date: <input type="date" @bind="_date" /></label>
        <label>Gross Amount: <input type="number" step="0.01" @bind="_amount" style="width:100px" /></label>
        <label>
            Currency:
            <select @bind="_currency">
                <option value="EUR">EUR</option>
                <option value="USD">USD</option>
                <option value="GBP">GBP</option>
                <option value="GBX">GBX (pence)</option>
            </select>
        </label>
        <label>Withholding Tax: <input type="number" step="0.01" @bind="_withholdingTax" style="width:80px" /></label>
        <button class="primary-btn" @onclick="AddDividend">+ Add</button>
    </div>
    @if (_message != null)
    {
        <p style="color:var(--good); margin-top:0.5rem">@_message</p>
    }
</div>