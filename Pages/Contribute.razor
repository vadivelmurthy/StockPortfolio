@page "/contribute"
@inject DataStore Store
<h1>Add Contribution</h1>
<p class="subtitle">Log a new purchase — this adds to the holding's existing Value automatically.</p>
<table class="grid">
    <thead>
        <tr>
            <th>Holding</th>
            <th>Currency</th>
            <th>Current Value</th>
            <th>Amount to Add</th>
            <th>Fee (€/$)</th>
            <th>Qty Received (shares or XAU/XAG)</th>
            <th>Purchase Date</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Store.Data.Holdings)
        {
            <tr>
                <td>@h.Name</td>
                <td>@h.Currency</td>
                <td class="num">@h.Value.ToString("N2")</td>
                <td><input type="number" step="0.01" @bind="_amounts[h.Id]" style="width:100px" /></td>
                <td><input type="number" step="0.01" @bind="_fees[h.Id]" style="width:80px" placeholder="0" /></td>
                <td>
                    @if (IsMetalTicker(h.TickerSymbol))
                    {
                        <input type="number" step="0.000001" @bind="_quantities[h.Id]" style="width:110px" placeholder="XAU/XAG units e.g. 0.080363" />
                    }
                    else
                    {
                        <input type="number" step="0.000001" @bind="_quantities[h.Id]" style="width:110px" placeholder="shares e.g. 0.1627" />
                    }
                </td>
                <td><input type="date" @bind="_dates[h.Id]" /></td>
                <td><button class="primary-btn" @onclick="() => AddAmount(h)">Add</button></td>
            </tr>
        }
    </tbody>
</table>
@if (_lastMessage != null)
{
    <div class="card status good" style="margin-top:1rem">@_lastMessage</div>
}
@code {
    private Dictionary<Guid, decimal> _amounts = new();
    private Dictionary<Guid, decimal> _quantities = new();
    private Dictionary<Guid, DateTime> _dates = new();
    private Dictionary<Guid, decimal> _fees = new();
    private string? _lastMessage;
    protected override void OnInitialized()
    {
        foreach (var h in Store.Data.Holdings)
        {
            _amounts[h.Id] = 0;
            _quantities[h.Id] = 0;
            _dates[h.Id] = DateTime.Today;
            _fees[h.Id] = 0;
        }
    }
    private void AddAmount(PortfolioHolding h)
    {
        var amount = _amounts.GetValueOrDefault(h.Id, 0);
        if (amount == 0) return;
        var date = _dates.GetValueOrDefault(h.Id, DateTime.Today);
        h.Value += amount;
        var qty = _quantities.GetValueOrDefault(h.Id, 0);
        var fee = _fees.GetValueOrDefault(h.Id, 0);
        Store.Data.Transactions.Add(new Transaction { HoldingId = h.Id, Date = DateOnly.FromDateTime(date), Amount = amount, Fee = fee, QuantityReceived = qty });
        Store.Save();
        _lastMessage = $"Added {h.Currency} {amount:N2} to {h.Name} on {date:dd MMM yyyy} — new total: {h.Currency} {h.Value:N2}";
        _amounts[h.Id] = 0;
        _quantities[h.Id] = 0;
        _fees[h.Id] = 0;
    }
    private bool IsMetalTicker(string? ticker) => ticker == "GC=F" || ticker == "SI=F";
}