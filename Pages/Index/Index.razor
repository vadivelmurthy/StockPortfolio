@page "/"
@inject DataStore Store
@inject PriceService Prices
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@implements IDisposable

<h1>Portfolio Snapshot</h1>
<p class="subtitle">
    Live USD→EUR rate and ticker prices refresh every 5 seconds.
    @if (_lastRefresh.HasValue)
    {
        <span>Last updated @_lastRefresh.Value.ToString("HH:mm:ss")</span>
    }
    <button class="link-btn" @onclick="RefreshNow" style="margin-left:0.5rem">↻ refresh now</button>
</p>

<div class="card">
    <label>USD → EUR rate (live):
        <input type="number" step="0.0001" value="@Store.Data.UsdToEurRate" @onchange="e => { Store.Data.UsdToEurRate = ParseDec(e.Value); Store.Save(); }" style="width:100px" />
    </label>
    @if (_fxError)
    {
        <span style="color:var(--bad); margin-left:0.6rem">live fetch failed — using last known/manual value</span>
    }
</div>
@{
    // Goal start: when you began the 8-year journey (Feb 2026)
    var goalStart = new DateOnly(2026, 2, 1);
    var goalEnd = goalStart.AddYears(8);           // Feb 2034
    var today = DateOnly.FromDateTime(DateTime.Today);

    var totalDays = (goalEnd.ToDateTime(TimeOnly.MinValue) - goalStart.ToDateTime(TimeOnly.MinValue)).TotalDays;
    var elapsedDays = (today.ToDateTime(TimeOnly.MinValue) - goalStart.ToDateTime(TimeOnly.MinValue)).TotalDays;
    var remainingDays = (goalEnd.ToDateTime(TimeOnly.MinValue) - today.ToDateTime(TimeOnly.MinValue)).TotalDays;

    var pct = Math.Clamp((elapsedDays / totalDays) * 100, 0, 100);

    var yrsLeft = (int)(remainingDays / 365);
    var monthsLeft = (int)((remainingDays % 365) / 30);
    var daysLeftDisplay = (int)Math.Max(0, remainingDays);

    var isDue = today >= goalEnd;
    var isNearing = remainingDays <= 90 && remainingDays > 0;  // final 3 months
}
@if (isDue)
{
    <div class="sell-now-banner" @onclick="@(() => Nav.NavigateTo("/sell"))" style="cursor:pointer">
        <div class="sell-now-text">🚨 SELL NOW — 8-YEAR DEADLINE REACHED 🚨</div>
        <div class="sell-now-sub">Deemed disposal (41% exit tax) is due. Sell ETFs before this date to pay CGT (33%) instead. → Click to record sale</div>
    </div>
}
else
{
    <div class="goal-clock-widget @(isNearing ? "nearing" : "")">
        <div class="goal-clock-header">
            <span class="goal-clock-title">⏳ 8-Year Goal Clock</span>
            <span class="goal-clock-target">Target: @goalEnd.ToString("MMM yyyy")</span>
        </div>

        <div class="goal-clock-countdown">
            <strong>@yrsLeft</strong>y <strong>@monthsLeft</strong>m
            <span class="goal-clock-days">(@daysLeftDisplay.ToString("N0") days left)</span>
        </div>

        <div class="goal-clock-bar">
            <div class="goal-clock-fill" style="width:@pct.ToString("F1")%"></div>
        </div>

        <div class="goal-clock-foot">
            @pct.ToString("F1")% elapsed
            @if (isNearing)
            {
                <span class="goal-clock-warn"> — ⚠️ final 3 months, prepare to sell!</span>
            }
        </div>
    </div>
}
@{
    var nextVest = Store.Data.EsppCycles
        .Where(e => !e.Sold && e.VestDate >= DateOnly.FromDateTime(DateTime.Today))
        .OrderBy(e => e.VestDate)
        .FirstOrDefault();
    var daysToVest = nextVest != null
           ? (nextVest.VestDate.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days
           : -1;
    var cgtUsed = Store.Data.CgtSales
        .Where(s => s.DateSold.Year == DateTime.Today.Year)
        .Sum(s => s.Gain);
    var cgtRemaining = Store.Data.AnnualCgtAllowance - cgtUsed;
}
@if (daysToVest >= 0 && daysToVest <= 30)
{
    <div class="card status @(daysToVest <= 7 ? "bad" : "neutral")" style="margin-bottom:1rem">
        <strong>⚠️ ESPP Vesting in @daysToVest days (@nextVest!.VestDate.ToString("dd MMM yyyy"))</strong><br />
        Remember: sell UHG shares immediately → reinvest 50/50 into NatWest + AstraZeneca
    </div>
}
@if (daysToVest < 0)
{
    <div class="card status good" style="margin-bottom:1rem">
        <strong>✅ No ESPP vesting due in next 30 days</strong>
    </div>
}
<div class="card" style="margin-bottom:1rem">
    <strong>📅 Upcoming Dividends</strong>
    <table style="width:100%; margin-top:0.5rem; font-size:0.85rem">
        @foreach (var h in Store.Data.Holdings.Where(h => !IsMetalTicker(h.TickerSymbol) && !string.IsNullOrWhiteSpace(h.TickerSymbol)))
        {
            // Get last logged dividend for this holding
            var lastDiv = Store.Data.Dividends
            .Where(d => d.HoldingId == h.Id)
            .OrderByDescending(d => d.Date)
            .FirstOrDefault();
            // Calculate next expected date (quarterly = +3 months from last)
            DateOnly? nextExpected = lastDiv != null
            ? lastDiv.Date.AddMonths(3)
            : null;
            // Get live amount from Yahoo if available
            var hasLive = _upcomingDividends.TryGetValue(h.TickerSymbol, out var live);
            var amountPerShare = hasLive && live.amount > 0
            ? live.amount
            : lastDiv?.Amount ?? 0;
            // Use Yahoo ex-date if available, otherwise use calculated next date
            var exDate = hasLive && live.exDate.HasValue
            ? live.exDate.Value
            : nextExpected?.AddDays(-14); // approx ex-date = pay date - 14 days
            var payDate = hasLive && live.payDate.HasValue
            ? live.payDate.Value
            : nextExpected;
            var daysToEx = exDate.HasValue
            ? (exDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days
            : -1;
            // Calculate expected amount based on shares held × amount per share
            var sharesHeld = ActualUnits(h);
            var expectedPayout = sharesHeld * amountPerShare;
            if (amountPerShare == 0 && !hasLive) continue; // skip if no data at all
                                                           <tr>
                                                               <td style="padding:0.3rem 0.5rem"><strong>@h.Name</strong></td>
                                                               <td style="padding:0.3rem 0.5rem">
                                                                   ~@amountPerShare.ToString("N4") @h.Currency/share
                    @if (sharesHeld > 0)
                    {
                        <span style="color:var(--good)"> → ~@expectedPayout.ToString("N4") @h.Currency total</span>
                    }
                </td>
                <td style="padding:0.3rem 0.5rem">
                    Ex-div: @(exDate.HasValue? exDate.Value.ToString("dd MMM yyyy") : "—")
                    @if (daysToEx >= 0 && daysToEx <= 7)
                    {
                        <span style="color:var(--bad)"> ⚠️ @daysToEx days!</span>
                    }
                    else if (daysToEx < 0 && exDate.HasValue)
                    {
                        <span style="color:var(--muted)"> (passed)</span>
                    }
                </td>
                <td style="padding:0.3rem 0.5rem">
                    Pay: @(payDate.HasValue? payDate.Value.ToString("dd MMM yyyy") : "—")
                    @if (lastDiv != null)
                    {
                        <span style="color:var(--muted)"> (est. from last: @lastDiv.Date.ToString("MMM yyyy"))</span>
                    }
                </td>
            </tr>
        }
    </table>
    <p style="font-size:0.78rem; color:var(--muted); margin:0.5rem 0 0">
        Amounts from Yahoo Finance. Dates estimated quarterly from last logged dividend.
        Updates automatically as dividends are logged.
    </p>
</div>
<div class="card" style="margin-bottom:1rem; display:flex; gap:2rem; align-items:center">
    <div>
        <strong>CGT Allowance @DateTime.Today.Year</strong><br />
        <span class="muted-text">€@cgtUsed.ToString("N2") used of €@Store.Data.AnnualCgtAllowance.ToString("N2")</span>
    </div>
    <div style="flex:1; background:var(--panel-2); border-radius:6px; height:12px; overflow:hidden">
        <div style="width:@(Math.Min(100, (double)(cgtUsed / Store.Data.AnnualCgtAllowance) * 100))%; height:100%; background:@(cgtRemaining < 0 ? "var(--bad)" : "var(--accent)"); border-radius:6px"></div>
    </div>
    <div>
        <strong style="color:@(cgtRemaining < 0 ? "var(--bad)" : "var(--good)")">€@cgtRemaining.ToString("N2") remaining</strong>
    </div>
</div>

@{
    var etfHoldings = Store.Data.Holdings
        .Where(h => h.TickerSymbol == "VUSA.AS" || h.TickerSymbol == "IUSA.AS")
        .ToList();
}
@if (etfHoldings.Any())
{
    <div class="card" style="margin-bottom:1rem">
        <strong>⏱️ ETF Deemed Disposal Tracker (8-year rule)</strong>
        <table style="width:100%; margin-top:0.5rem; font-size:0.88rem">
            @foreach (var etf in etfHoldings)
            {
                var dueDate = etf.StartDate.AddYears(8);
                var daysLeft = (dueDate.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
                var yearsLeft = daysLeft / 365.0;
                <tr>
                    <td style="padding:0.3rem 0.5rem">@etf.Name (@etf.TickerSymbol)</td>
                    <td style="padding:0.3rem 0.5rem">Started: @etf.StartDate.ToString("MMM yyyy")</td>
                    <td style="padding:0.3rem 0.5rem">Deemed disposal due: <strong>@dueDate.ToString("MMM yyyy")</strong></td>
                    <td style="padding:0.3rem 0.5rem; color:@(daysLeft < 365 ? "var(--bad)" : "var(--good)")">
                        @yearsLeft.ToString("N1") years remaining
                    </td>
                </tr>
            }
        </table>
        <p style="margin:0.5rem 0 0; font-size:0.82rem; color:var(--muted)">
            Sell before deemed disposal date to pay CGT (33%) instead of Exit Tax (41%)
        </p>
    </div>
}
<div style="display:flex; gap:0.5rem; margin-bottom:1rem">
    <button class="primary-btn @(activeTab == "overall" ? "" : "secondary-btn")" @onclick='() => activeTab = "overall"'>Overall</button>
    <button class="primary-btn @(activeTab == "stocks" ? "" : "secondary-btn")" @onclick='() => activeTab = "stocks"'>Stocks & ETFs</button>
    <button class="primary-btn @(activeTab == "metals" ? "" : "secondary-btn")" @onclick='() => activeTab = "metals"'>Metals</button>
</div>
<table class="grid">
    <thead>
        <tr>
            <th>Holding</th>
            <th>Ticker (optional)</th>
            <th>Start Date</th>
            <th>Currency</th>
            <th>Shares/Grams</th>
            <th>Live Price</th>
            <th>Invested (€)</th>
            <th>Current Value (€)</th>
            <th>Target Progress</th>
            <th>Profit/Loss</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
       @*  @foreach (var h in Store.Data.Holdings) *@
        @foreach (var h in FilteredHoldings())
        {
            <tr>
                <td><input value="@h.Name" @onchange="e => UpdateName(h, e.Value)" /></td>
                <td><input value="@h.TickerSymbol" placeholder="e.g. NVDA" style="width:90px" @onchange="e => UpdateTicker(h, e.Value)" /></td>
                <td><input type="date" value="@h.StartDate.ToString("yyyy-MM-dd")" @onchange="e => { h.StartDate = DateOnly.Parse(e.Value!.ToString()!); Save(); }" /></td>
                <td>
                    <select value="@h.Currency" @onchange="e => UpdateCurrency(h, e.Value)">
                        <option value="EUR">EUR</option>
                        <option value="USD">USD</option>
                        <option value="GBP">GBP</option>
                    </select>
                </td>
                <td class="num">
                    @if (IsMetalTicker(h.TickerSymbol))
                    {
                        var actualOz = Store.Data.Transactions
                        .Where(t => t.HoldingId == h.Id && t.QuantityReceived > 0)
                        .Sum(t => t.QuantityReceived);
                        var actualGrams = actualOz * 31.1034768m;
                        if (actualGrams > 0)
                        {
                            <span>@actualGrams.ToString("N4") g</span>
                        }
                        else
                        {
                            <span class="muted-text">—</span>
                        }
                    }
                    else
                    {
                        var units = ActualUnits(h);
                        if (units > 0)
                        {
                            <span>@units.ToString("N4")</span>
                        }
                        else
                        {
                            <span class="muted-text">—</span>
                        }
                    }
                </td>
                <td class="num">
                    @if (IsMetalTicker(h.TickerSymbol) && _metalPricesPerGramEur.TryGetValue(h.TickerSymbol, out var mp))
                    {
                        @($"€{mp * 31.1034768m:N2}/oz (€{mp:N4}/g)")
                    }
                    else if (IsMetalTicker(h.TickerSymbol))
                    {
                        <span class="muted-text">fetching…</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(h.TickerSymbol) && _livePrices.TryGetValue(h.TickerSymbol, out var p))
                    {
                        @p.ToString("N2")
                    }
                    else if (!string.IsNullOrWhiteSpace(h.TickerSymbol))
                    {
                        <span class="muted-text">fetching…</span>
                    }
                    else
                    {
                        <span class="muted-text">—</span>
                    }
                </td>
                <td class="num">€@InvestedEur(h).ToString("N2")</td>
                <td class="num">€@ToEur(h).ToString("N2")</td>
                <td style="min-width:180px">
                    @{
                        var target = TargetFor(h.TickerSymbol);
                        var held = IsMetalTicker(h.TickerSymbol) ? MetalGrams(h) : ActualUnits(h);
                    }
                    @if (target > 0)
                    {
                        var remaining = Math.Max(0, target - held);
                        var targetPct = target > 0 ? Math.Min(100, (double)(held / target) * 100) : 0;
                        <div style="font-size:0.8rem; margin-bottom:0.2rem">
                            <strong>@held.ToString("N2")</strong> / @target.ToString("N0") @(IsMetalTicker(h.TickerSymbol) ? "g" : "sh")
                            <span style="color:var(--muted)"> · @remaining.ToString("N2") to go</span>
                        </div>
                        <div style="background:#0d1526; border-radius:5px; height:8px; overflow:hidden">
                            <div style="width:@targetPct.ToString("F1")%; height:100%;
                background:@(targetPct >= 100 ? "var(--good)" : "linear-gradient(90deg,#4da6ff,#00d4aa)");
                border-radius:5px"></div>
                        </div>
                        <div style="font-size:0.72rem; color:var(--muted); margin-top:0.15rem">
                            @targetPct.ToString("F1")% @(targetPct >= 100 ? "✅ goal reached!" : "")
                        </div>
                    }
                    else
                    {
                        <span style="color:var(--muted); font-size:0.8rem">—</span>
                    }
                </td>
                <td class="num" style="@(Pnl(h) >= 0 ? "color:var(--good)" : "color:var(--bad)")">@PnlText(h)</td>
                <td><button class="link-btn" @onclick="() => Remove(h)">✕</button></td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td class="num"><strong>Total:</strong></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td class="num"><strong>€@FilteredInvestedEur().ToString("N2")</strong></td>
            <td class="num"><strong>€@FilteredCurrentEur().ToString("N2")</strong></td>
            <td></td>
            <td class="num @FilteredPnlClass()"><strong>@FilteredPnlText()</strong></td>
            <td></td>
        </tr>
    </tfoot>
</table>

<div style="display:flex; gap:0.6rem; margin-top:0.75rem">
    <button class="primary-btn" @onclick="AddHolding">+ Add holding</button>
    <button class="primary-btn" @onclick="GoToContribute">+ Add contribution</button>
    <button class="primary-btn" @onclick="GoToSell">- Record sale</button>
</div>

<div class="card" style="margin-top:2rem">
    <h3>Projection to €250,000</h3>

    <p style="color:var(--muted); font-size:0.85rem; margin-top:0">
        Includes all holdings except your ESPP (UNH). Monthly figure is your real
        average from logged contributions. Projection uses a forward return assumption.
    </p>

    <div style="display:flex; gap:2rem; flex-wrap:wrap; margin:1rem 0">
        <div>
            <span style="color:var(--muted); font-size:0.8rem">Goal Value (ex-ESPP)</span><br />
            <strong style="font-size:1.2rem">€@GoalValue().ToString("N2")</strong>
        </div>
        <div>
            <span style="color:var(--muted); font-size:0.8rem">Avg Monthly Investment</span><br />
            <strong style="font-size:1.2rem; color:var(--good)">€@AutoMonthly().ToString("N2")</strong>
        </div>
        <div>
            <span style="color:var(--muted); font-size:0.8rem">Your Return So Far</span><br />
            <strong style="font-size:1.2rem; color:@(ActualReturnPct() >= 0 ? "var(--good)" : "var(--bad)")">
                @(ActualReturnPct() >= 0 ? "+" : "")@ActualReturnPct().ToString("N1")%
            </strong>
        </div>
    </div>

    @if (ActualReturnPct() < 0)
    {
        <div class="alert" style="background:#3a2a1a; border:1px solid #7a5a2a; border-radius:8px; padding:0.6rem 1rem; margin-bottom:1rem; font-size:0.85rem">
            ⚠️ Your portfolio is currently down @Math.Abs(ActualReturnPct()).ToString("N1")%.
            Early volatility is normal — the projection below uses a long-term assumption,
            not your short-term return. Once your return turns positive, it'll show here in green.
        </div>
    }
    else
    {
        <div class="alert" style="background:#1a3a2a; border:1px solid #2a7a5a; border-radius:8px; padding:0.6rem 1rem; margin-bottom:1rem; font-size:0.85rem">
            ✅ Your portfolio is up @ActualReturnPct().ToString("N1")% so far — nicely on track.
        </div>
    }

    <label>
        Assumed annual return %:
        <input type="number" step="0.5" @bind="AnnualReturnPct" style="width:80px" />
    </label>
    <label style="margin-left:1rem">
        Override monthly (€):
        <input type="number" step="1" @bind="ManualOverride" placeholder="auto" style="width:100px" />
    </label>

    <p style="margin-top:1rem">
        At <strong>@AnnualReturnPct%</strong> assumed annual return, investing
        <strong>€@EffectiveMonthly().ToString("N2")</strong>/month from your current
        <strong>€@GoalValue().ToString("N2")</strong>,
        you reach <strong>€250,000</strong> in approximately
        <strong>@YearsToTarget() years @MonthsToTarget() months</strong>.
    </p>
</div>

<div class="card" style="margin-top:2rem">
    <h3>🏁 8-Year Exit Plan — Sell All Except Metals</h3>
    <p style="color:var(--muted); font-size:0.85rem; margin-top:0">
        Projects cashing out all stocks &amp; ETFs at your goal date (@ExitDate.ToString("MMM yyyy")),
        keeping gold &amp; silver. Irish tax: CGT 33% on stocks, exit tax 41% on ETFs — applied to gains only.
    </p>

    <div style="display:flex; gap:2rem; flex-wrap:wrap; margin-top:1rem">

        @* ── TODAY ── *@
        <div style="flex:1; min-width:260px; background:var(--panel-2); border-radius:10px; padding:1rem">
            <h4 style="margin-top:0">If sold today</h4>
            <div class="exit-row"><span>Holdings sold</span><strong>@SellCountToday()</strong></div>
            <div class="exit-row"><span>Gross value</span><strong>€@SellValueNow().ToString("N2")</strong></div>
            <div class="exit-row"><span>Irish tax</span><strong style="color:var(--bad)">−€@TaxNow().ToString("N2")</strong></div>
            <div class="exit-row exit-total"><span>After-tax</span><strong style="color:var(--good)">€@((SellValueNow() - TaxNow()).ToString("N2"))</strong></div>
            <div class="exit-row"><span>Return after tax</span><strong style="color:@(ReturnTodayPct() >= 0 ? "var(--good)" : "var(--bad)")">@(ReturnTodayPct() >= 0 ? "+" : "")@ReturnTodayPct().ToString("N1")%</strong></div>
        </div>

        @* ── 2034 ── *@
        <div style="flex:1; min-width:260px; background:var(--panel-2); border-radius:10px; padding:1rem">
            <h4 style="margin-top:0">Projected @ExitDate.Year (@MonthsToExit() months away)</h4>
            <div class="exit-row"><span>Gross value</span><strong>€@ProjectedValue2034().ToString("N2")</strong></div>
            <div class="exit-row"><span>Total invested by then</span><strong>€@ProjectedInvested2034().ToString("N2")</strong></div>
            <div class="exit-row"><span>Irish tax</span><strong style="color:var(--bad)">−€@Tax2034().ToString("N2")</strong></div>
            <div class="exit-row exit-total"><span>After-tax</span><strong style="color:var(--good)">€@((ProjectedValue2034() - Tax2034()).ToString("N2"))</strong></div>
            <div class="exit-row"><span>Return after tax</span><strong style="color:@(Return2034Pct() >= 0 ? "var(--good)" : "var(--bad)")">@(Return2034Pct() >= 0 ? "+" : "")@Return2034Pct().ToString("N1")%</strong></div>
            <div class="exit-row"><span>Per year (annualized)</span><strong style="color:var(--good)">@(AnnualizedReturn2034() >= 0 ? "+" : "")@AnnualizedReturn2034().ToString("N1")%/yr</strong></div>
        </div>
    </div>
    <div style="margin-top:1rem; border-top:1px solid #444; padding-top:0.75rem">
        <h4 style="margin-top:0">Scenario range (after-tax)</h4>
        <div class="exit-row">
            <span>😟 Conservative (4%)</span>
            <strong>€@ProjectedAfterTaxAt(4).ToString("N0")</strong>
        </div>
        <div class="exit-row">
            <span>😐 Expected (7%)</span>
            <strong style="color:var(--good)">€@ProjectedAfterTaxAt(7).ToString("N0")</strong>
        </div>
        <div class="exit-row">
            <span>😄 Optimistic (10%)</span>
            <strong>€@ProjectedAfterTaxAt(10).ToString("N0")</strong>
        </div>
    </div>

    <p style="font-size:0.78rem; color:var(--muted); margin-top:1rem">
        Assumes @AnnualReturnPct% annual return and €@ExitMonthly().ToString("N0")/month contributions until @ExitDate.ToString("MMM yyyy").
        Gold &amp; silver are kept, not sold. Estimates only — not tax advice.
    </p>
</div>