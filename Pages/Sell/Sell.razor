@page "/sell"
@inject DataStore Store
<h1>Record a Sale</h1>
<p class="subtitle">Log a sale of stocks or metals. This reduces your holding and auto-creates a CGT entry.</p>
@if (_confirmation != null)
{
    <div class="card status good" style="margin-top:1rem">@_confirmation</div>
}
<table class="grid">
    <thead>
        <tr>
            <th>Holding</th>
            <th>Currency</th>
            <th>Current Units/Grams</th>
            <th>Units/Grams to Sell</th>
            <th>Sale Proceeds (€)</th>
            <th>Sale Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Store.Data.Holdings)
        {
            var units = ActualUnits(h);
            var displayUnits = IsMetalTicker(h.TickerSymbol)
            ? $"{(units * 31.1034768m):N4} g ({units:N6} oz)"
            : $"{units:N4} shares";
            <tr>
                <td>@h.Name</td>
                <td>@h.Currency</td>
                <td class="num">@displayUnits</td>
                <td><input type="number" step="0.000001" @bind="_unitsToSell[h.Id]" style="width:110px" placeholder="0" /></td>
                <td><input type="number" step="0.01" @bind="_proceeds[h.Id]" style="width:110px" placeholder="€ received" /></td>
                <td><input type="date" @bind="_saleDates[h.Id]" /></td>
                <td><button class="primary-btn" @onclick="() => RecordSale(h)">Sell</button></td>
            </tr>
        }
    </tbody>
</table>